{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunny-cad.local/esquemas/componente.schema.json",
  "title": "Componente de biblioteca",
  "description": "Un equipo de la biblioteca (library/). Todo dato técnico debe venir de la ficha técnica citada en 'fuente'. Unidades en el nombre del campo: _mm, _kg, _w, _kwh, _v, _a, _ah, _hz, _pct, _c, _m, _ms, _pa.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version_esquema", "id", "tipo", "es_ejemplo", "marca", "fabricante", "modelo", "fuente", "electrico"],
  "properties": {
    "version_esquema": { "const": "1.1.0" },
    "id": {
      "description": "Identificador del equipo en la biblioteca: minúsculas, sin tildes ni espacios, separado por guiones. Igual al nombre del archivo.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "tipo": {
      "enum": ["modulo", "inversor", "bateria", "tablero", "proteccion", "estructura", "medidor", "monitoreo", "conmutacion"]
    },
    "es_ejemplo": {
      "description": "true si el componente es ficticio (solo para pruebas). Nunca usar un componente de ejemplo en un diseño real.",
      "type": "boolean"
    },
    "marca": {
      "description": "Marca comercial normalizada (minúsculas): huawei, deye, livoltek, ja-solar, star… Se usa para las reglas de compatibilidad.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "fabricante": { "type": "string", "minLength": 1 },
    "modelo": { "type": "string", "minLength": 1 },
    "fuente": { "$ref": "#/$defs/fuente" },
    "dimensiones": { "$ref": "#/$defs/dimensiones" },
    "ambiente": { "$ref": "#/$defs/ambiente" },
    "electrico": { "type": "object" },
    "notas": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "tipo": { "const": "modulo" } } },
      "then": {
        "required": ["dimensiones"],
        "properties": {
          "dimensiones": { "$ref": "#/$defs/dimensiones_completas" },
          "electrico": { "$ref": "#/$defs/electrico_modulo" }
        }
      }
    },
    {
      "if": { "properties": { "tipo": { "const": "inversor" } } },
      "then": {
        "required": ["dimensiones"],
        "properties": {
          "dimensiones": { "$ref": "#/$defs/dimensiones_completas" },
          "electrico": { "$ref": "#/$defs/electrico_inversor" }
        }
      }
    },
    {
      "if": { "properties": { "tipo": { "const": "medidor" } } },
      "then": { "properties": { "electrico": { "$ref": "#/$defs/electrico_medidor" } } }
    },
    {
      "if": { "properties": { "tipo": { "const": "conmutacion" } } },
      "then": { "properties": { "electrico": { "$ref": "#/$defs/electrico_conmutacion" } } }
    },
    {
      "if": { "properties": { "tipo": { "const": "bateria" } } },
      "then": { "properties": { "electrico": { "$ref": "#/$defs/electrico_bateria" } } },
      "else": { "required": ["dimensiones"] }
    }
  ],
  "$defs": {
    "fuente": {
      "description": "Ficha técnica de origen de todos los datos del componente.",
      "type": "object",
      "additionalProperties": false,
      "required": ["documento", "revision", "fecha_consulta"],
      "properties": {
        "documento": {
          "description": "Título del documento tal como aparece en la ficha.",
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "description": "Versión o revisión de la ficha (por ejemplo 'Version No.: 01-202402'). Si la ficha no la indica, escribir 'sin revision'.",
          "type": "string",
          "minLength": 1
        },
        "fecha_consulta": {
          "description": "Fecha en que se tomó la ficha (AAAA-MM-DD).",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "url": { "type": "string", "pattern": "^https?://" },
        "archivo": {
          "description": "Ruta de la ficha dentro del repositorio, si se guardó una copia.",
          "type": "string"
        },
        "paginas": { "type": "string" }
      }
    },
    "positivo": { "type": "number", "exclusiveMinimum": 0 },
    "no_negativo": { "type": "number", "minimum": 0 },
    "rango_v": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_v", "max_v"],
      "properties": {
        "min_v": { "$ref": "#/$defs/no_negativo" },
        "max_v": { "$ref": "#/$defs/positivo" }
      }
    },
    "dimensiones": {
      "description": "Dimensiones exteriores en mm como las da la ficha: ancho (W) × alto (H) × profundidad (D). En módulos FV: alto = lado largo, ancho = lado corto, profundidad = espesor del marco.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ancho_mm", "alto_mm"],
      "properties": {
        "ancho_mm": { "$ref": "#/$defs/positivo" },
        "alto_mm": { "$ref": "#/$defs/positivo" },
        "profundidad_mm": { "$ref": "#/$defs/positivo" },
        "peso_kg": { "$ref": "#/$defs/positivo" },
        "nota": {
          "description": "Aclaración de la ficha, por ejemplo 'sin conectores ni soportes' o 'incluye placa de montaje'.",
          "type": "string"
        }
      }
    },
    "dimensiones_completas": {
      "description": "Módulos e inversores necesitan las tres medidas y el peso para la distribución y el montaje.",
      "required": ["ancho_mm", "alto_mm", "profundidad_mm", "peso_kg"]
    },
    "electrico_medidor": {
      "description": "Medidor de energía en el PCC.",
      "type": "object",
      "additionalProperties": false,
      "required": ["conexiones", "tension_nominal_texto", "corriente_max_a", "bidireccional", "montaje"],
      "properties": {
        "conexiones": {
          "description": "Tipos de conexión admitidos: 1F-2H, 1F-3H, 2F-3H, 3F-4H.",
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["1F-2H", "1F-3H", "2F-3H", "3F-4H"] }
        },
        "tension_nominal_texto": {
          "description": "Tal como la da la ficha, por ejemplo '3x120/208V'.",
          "type": "string",
          "minLength": 1
        },
        "rango_tension_pct_un": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_pct", "max_pct"],
          "properties": { "min_pct": { "type": "number" }, "max_pct": { "type": "number" } }
        },
        "frecuencias_hz": { "type": "array", "items": { "$ref": "#/$defs/positivo" } },
        "corriente_nominal_a": { "$ref": "#/$defs/positivo" },
        "corriente_max_a": { "$ref": "#/$defs/positivo" },
        "conexion_directa": {
          "description": "true si mide directo (sin transformadores de corriente).",
          "type": "boolean"
        },
        "clase_energia_activa": { "type": "string" },
        "clase_energia_reactiva": { "type": "string" },
        "bidireccional": { "type": "boolean" },
        "montaje": { "enum": ["riel_din", "base_socket", "otro"] },
        "comunicaciones": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ambiente": {
      "description": "Condiciones de operación según la ficha.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grado_proteccion": {
          "description": "Tal como lo da la ficha: 'IP66', 'IP65', 'TYPE3R'…",
          "type": "string"
        },
        "temperatura_operacion_min_c": { "type": "number" },
        "temperatura_operacion_max_c": { "type": "number" },
        "altitud_max_m": { "$ref": "#/$defs/positivo" },
        "altitud_sin_reduccion_m": {
          "description": "Altitud hasta la cual no hay reducción de potencia (derating).",
          "$ref": "#/$defs/positivo"
        },
        "instalacion": { "enum": ["interior", "exterior", "interior_exterior"] }
      }
    },
    "electrico_modulo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "potencia_stc_w",
        "voc_v",
        "isc_a",
        "vmp_v",
        "imp_a",
        "coef_temp_voc_pct_c",
        "coef_temp_pmax_pct_c",
        "tension_max_sistema_v"
      ],
      "properties": {
        "potencia_stc_w": { "$ref": "#/$defs/positivo" },
        "voc_v": { "$ref": "#/$defs/positivo" },
        "isc_a": { "$ref": "#/$defs/positivo" },
        "vmp_v": { "$ref": "#/$defs/positivo" },
        "imp_a": { "$ref": "#/$defs/positivo" },
        "eficiencia_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "tolerancia_potencia_pct": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_pct", "max_pct"],
          "properties": { "min_pct": { "type": "number" }, "max_pct": { "type": "number" } }
        },
        "coef_temp_voc_pct_c": { "type": "number" },
        "coef_temp_isc_pct_c": { "type": "number" },
        "coef_temp_pmax_pct_c": { "type": "number" },
        "noct_c": { "type": "number" },
        "tension_max_sistema_v": { "$ref": "#/$defs/positivo" },
        "fusible_max_serie_a": { "$ref": "#/$defs/positivo" },
        "numero_celdas": { "type": "integer", "minimum": 1 },
        "bifacial": { "type": "boolean" },
        "bifacialidad_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "carga_estatica_frontal_pa": { "$ref": "#/$defs/positivo" },
        "carga_estatica_posterior_pa": { "$ref": "#/$defs/positivo" }
      }
    },
    "electrico_inversor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo_inversor",
        "fases",
        "conexion_red",
        "potencia_nominal_ac_w",
        "tensiones_nominales_ac_v",
        "frecuencias_hz",
        "numero_mppt",
        "entradas_fv_totales",
        "tension_max_dc_v",
        "rango_mppt",
        "corriente_max_entrada_por_mppt_a"
      ],
      "properties": {
        "tipo_inversor": { "enum": ["hibrido", "red", "aislado"] },
        "fases": { "enum": ["monofasica", "bifasica", "trifasica"] },
        "conexion_red": {
          "description": "Forma de conexión tal como la da la ficha: 'L/N+PE', '3L+N+PE'…",
          "type": "string",
          "minLength": 1
        },
        "potencia_nominal_ac_w": { "$ref": "#/$defs/positivo" },
        "potencia_aparente_max_va": { "$ref": "#/$defs/positivo" },
        "tensiones_nominales_ac_v": {
          "description": "Tensiones nominales admitidas. Trifásicos: tensión de línea (208 en un sistema 120/208).",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/positivo" }
        },
        "frecuencias_hz": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/positivo" }
        },
        "corriente_max_salida_ac_a": { "$ref": "#/$defs/positivo" },
        "corriente_max_paso_red_a": {
          "description": "Corriente continua máxima de paso red→carga a través del inversor.",
          "$ref": "#/$defs/positivo"
        },
        "potencia_max_entrada_fv_w": { "$ref": "#/$defs/positivo" },
        "potencia_fv_max_conectable_w": {
          "description": "Potencia FV máxima que se puede conectar (DEYE: 'Max. PV Access Power'; Huawei: 'Potencia FV máxima recomendada').",
          "$ref": "#/$defs/positivo"
        },
        "numero_mppt": { "type": "integer", "minimum": 1 },
        "entradas_fv_totales": { "type": "integer", "minimum": 1 },
        "tension_max_dc_v": { "$ref": "#/$defs/positivo" },
        "tension_arranque_v": { "$ref": "#/$defs/positivo" },
        "tension_nominal_dc_v": { "$ref": "#/$defs/positivo" },
        "rango_mppt": { "$ref": "#/$defs/rango_v" },
        "corriente_max_entrada_por_mppt_a": { "$ref": "#/$defs/positivo" },
        "corriente_max_cortocircuito_por_mppt_a": { "$ref": "#/$defs/positivo" },
        "strings_por_mppt": {
          "description": "Strings admitidos en cada MPPT, en orden (DEYE 2/2+2 → [2, 2]).",
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "corrientes_max_por_mppt_a": {
          "description": "Cuando la ficha da una corriente distinta por MPPT (Livoltek 32/32/16 A). El campo escalar guarda la mayor.",
          "type": "array",
          "items": { "$ref": "#/$defs/positivo" }
        },
        "corrientes_cortocircuito_por_mppt_a": {
          "type": "array",
          "items": { "$ref": "#/$defs/positivo" }
        },
        "eficiencia_max_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "eficiencia_europea_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "bateria": {
          "description": "Puerto de batería (solo inversores híbridos).",
          "type": "object",
          "additionalProperties": false,
          "required": ["nivel_tension", "rango_tension"],
          "properties": {
            "nivel_tension": { "enum": ["baja", "alta"] },
            "rango_tension": { "$ref": "#/$defs/rango_v" },
            "corriente_max_carga_a": { "$ref": "#/$defs/positivo" },
            "corriente_max_descarga_a": { "$ref": "#/$defs/positivo" },
            "potencia_max_carga_w": { "$ref": "#/$defs/positivo" },
            "potencia_max_descarga_w": { "$ref": "#/$defs/positivo" },
            "baterias_compatibles": {
              "description": "Modelos de batería que la ficha declara compatibles.",
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "respaldo": {
          "description": "Salida de respaldo (EPS / backup).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "potencia_respaldo_w": { "$ref": "#/$defs/positivo" },
            "potencia_pico_respaldo_w": { "$ref": "#/$defs/positivo" },
            "tiempo_conmutacion_ms": { "$ref": "#/$defs/no_negativo" },
            "equipo_externo_requerido": {
              "description": "Modelo del equipo externo que exige el respaldo, si aplica (por ejemplo 'SmartGuard-63A-S0').",
              "type": "string"
            }
          }
        }
      },
      "if": { "properties": { "tipo_inversor": { "const": "hibrido" } } },
      "then": { "required": ["bateria"] }
    },
    "electrico_conmutacion": {
      "description": "Equipos de conmutación red/respaldo: ATS, bypass, SmartGuard.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo_conmutacion", "tensiones_nominales_ac_v", "conexion_red", "corriente_max_red_a"],
      "properties": {
        "tipo_conmutacion": { "enum": ["ats", "bypass", "smartguard"] },
        "tensiones_nominales_ac_v": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/positivo" }
        },
        "conexion_red": { "type": "string", "minLength": 1 },
        "corriente_max_red_a": { "$ref": "#/$defs/positivo" },
        "corriente_max_inversor_a": { "$ref": "#/$defs/positivo" },
        "corriente_max_carga_respaldo_a": { "$ref": "#/$defs/positivo" },
        "corriente_max_carga_sin_respaldo_a": { "$ref": "#/$defs/positivo" },
        "tiempo_conmutacion_ms": { "$ref": "#/$defs/no_negativo" },
        "modo_bypass": { "enum": ["manual", "automatico", "no_tiene"] },
        "autoconsumo_w": { "$ref": "#/$defs/no_negativo" },
        "inversores_compatibles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "electrico_bateria": {
      "description": "Familia de batería modular. Los datos que dependen del número de módulos van en 'configuraciones', una por columna de la ficha.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tecnologia", "nivel_tension", "tiene_bms", "modulo_bateria", "configuraciones"],
      "properties": {
        "tecnologia": { "enum": ["lfp", "nmc", "otra"] },
        "nivel_tension": { "enum": ["baja", "alta"] },
        "tiene_bms": { "type": "boolean" },
        "marcas_inversor_compatibles": {
          "description": "Marcas de inversor con las que se puede usar esta batería (campo 'marca' del inversor).",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "max_sistemas_paralelo": {
          "description": "Máximo de sistemas (torres) iguales en paralelo sobre un inversor. Si falta, se admite 1.",
          "type": "integer",
          "minimum": 1
        },
        "max_modulos_por_sistema_en_paralelo": {
          "description": "Con más de un sistema en paralelo, máximo de módulos por sistema (torre).",
          "type": "integer",
          "minimum": 1
        },
        "profundidad_descarga_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "corriente_nominal_a": { "$ref": "#/$defs/positivo" },
        "corriente_pico_descarga_a": { "$ref": "#/$defs/positivo" },
        "rangos_tension": {
          "description": "Rangos de tensión de operación. Si la ficha da uno por tipo de sistema, uno por elemento.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["aplicacion", "min_v", "max_v"],
            "properties": {
              "aplicacion": { "enum": ["general", "sistema_monofasico", "sistema_trifasico"] },
              "min_v": { "$ref": "#/$defs/no_negativo" },
              "max_v": { "$ref": "#/$defs/positivo" }
            }
          }
        },
        "modulo_bateria": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modelo", "energia_kwh"],
          "properties": {
            "modelo": { "type": "string", "minLength": 1 },
            "energia_kwh": { "$ref": "#/$defs/positivo" },
            "tension_nominal_v": { "$ref": "#/$defs/positivo" },
            "capacidad_ah": { "$ref": "#/$defs/positivo" },
            "dimensiones": { "$ref": "#/$defs/dimensiones" }
          }
        },
        "partes": {
          "description": "Otras piezas del sistema (caja de control/BMS, módulo de potencia, base…).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["modelo", "funcion", "cantidad_por_sistema"],
            "properties": {
              "modelo": { "type": "string", "minLength": 1 },
              "funcion": { "enum": ["control_bms", "modulo_potencia", "base", "otra"] },
              "cantidad_por_sistema": { "type": "integer", "minimum": 1 },
              "dimensiones": { "$ref": "#/$defs/dimensiones" }
            }
          }
        },
        "configuraciones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "modulos_bateria", "energia_util_kwh"],
            "properties": {
              "id": {
                "description": "Identificador de la configuración, por ejemplo 'm3' para tres módulos.",
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "modelo_comercial": { "type": "string" },
              "modulos_bateria": { "type": "integer", "minimum": 1 },
              "pilas_fisicas": {
                "description": "Número de pilas físicas en que se reparten los módulos (Livoltek BHF-S25/S30 usan 2). No es paralelo eléctrico.",
                "type": "integer",
                "minimum": 1
              },
              "tension_nominal_v": { "$ref": "#/$defs/positivo" },
              "rango_tension": { "$ref": "#/$defs/rango_v" },
              "potencia_nominal_w": { "$ref": "#/$defs/positivo" },
              "potencia_max_w": { "$ref": "#/$defs/positivo" },
              "energia_nominal_kwh": { "$ref": "#/$defs/positivo" },
              "energia_util_kwh": { "$ref": "#/$defs/positivo" },
              "potencia_max_carga_w": { "$ref": "#/$defs/positivo" },
              "potencia_max_descarga_w": { "$ref": "#/$defs/positivo" },
              "dimensiones": { "$ref": "#/$defs/dimensiones" }
            }
          }
        }
      }
    }
  }
}
